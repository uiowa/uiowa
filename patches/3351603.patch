From 80b843eb0834a79dce8c593526ea5a9866fd9895 Mon Sep 17 00:00:00 2001
From: Klaas Van Waesberghe <klaasvw@gmail.com>
Date: Mon, 2 Sep 2024 15:44:28 +0200
Subject: [PATCH 3/6] Only set z-index one step higher so it doesn't conflict
 with other modals.

---
 core/modules/ckeditor5/css/editor.css | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/core/modules/ckeditor5/css/editor.css b/core/modules/ckeditor5/css/editor.css
index 3efb2f2f8171..1f08c5f16767 100644
--- a/core/modules/ckeditor5/css/editor.css
+++ b/core/modules/ckeditor5/css/editor.css
@@ -27,10 +27,10 @@
 
 /* Balloon panels need a higher z-index than Drupal's modals */
 .ck.ck-balloon-panel {
-  z-index: 1300 !important;
+  z-index: 1262 !important;
 }
 .ck.ck-balloon-panel.ck-tooltip {
-  z-index: 1301 !important;
+  z-index: 1263 !important;
 }
 
 /* Enhance visibility of selected/active buttons on the toolbar. */
-- 
GitLab


