+  /**
+   * Tests that the widget normalizes the submitted URI on save.
+   */
+  public function testUriIsNormalized() {
+    // Add a content type with a link field using the linkit_attributes widget.
+    $type = $this->drupalCreateContentType();
+    $field_name = mb_strtolower($this->randomMachineName());
+    $add_path = 'node/add/' . $type->id();
+
+    $this->fieldUIAddNewField('admin/structure/types/manage/' . $type->id(), $field_name, $field_name, 'link');
+    \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
+    \Drupal::entityTypeManager()
+      ->getStorage('entity_form_display')
+      ->load('node.' . $type->id() . '.default')
+      ->setComponent('field_' . $field_name, ['type' => 'linkit_attributes'])
+      ->save();
+
+    // Create the node that will be linked to.
+    $target = $this->drupalCreateNode(['type' => $type->id()]);
+
+    // Submit a schemeless path, as produced by Linkit. The link widget turns it
+    // into "internal:/node/N", which Linkit must then normalize.
+    $edit = [
+      'title[0][value]' => 'Linkit URI normalization',
+      'field_' . $field_name . '[0][uri]' => '/node/' . $target->id(),
+    ];
+    $this->drupalGet($add_path);
+    $this->submitForm($edit, 'Save');
+
+    $node = $this->drupalGetNodeByTitle($edit['title[0][value]']);
+    $this->assertEquals('entity:node/' . $target->id(), $node->get('field_' . $field_name)->uri);
+  }
+
   /**
    * Tests saving a node without any attributes enabled in the widget settings.
    */
